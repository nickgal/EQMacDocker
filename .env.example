DATABASE_USER=eqmac
DATABASE_PASSWORD=eqmacpassword
DATABASE_NAME=eqmac
SERVER_ADDRESS=192.168.1.100
SERVER_SHORT_NAME=EQMac Docker
SERVER_LONG_NAME=EQMac Docker
# Generate each with: openssl rand -hex 32
# Changing the salt invalidates every existing login account password.
LOGIN_PASSWORD_SALT=
WORLD_SHARED_KEY=

# Idle zone processes world assigns zones to as players enter them (0-254)
DYNAMIC_ZONES=10
# Minutes an empty dynamic zone waits before shutting down, counted in cycles
# from when it booted. Empty keeps the database's value (12 hours).
DYNAMIC_ZONE_SHUTDOWN_MINUTES=

# Zones kept running at all times, e.g. STATIC_ZONES=poknowledge,nexus
# Each gets the next port from STATIC_ZONE_PORT_START. Applied when world starts.
STATIC_ZONES=
STATIC_ZONE_PORT_START=7401
STATIC_ZONE_PORT_END=7425

# Optional tools: comma-separated list of phpmyadmin, peqeditor
COMPOSE_PROFILES=
# phpMyAdmin logs in with DATABASE_USER / DATABASE_PASSWORD
PHPMYADMIN_PORT=8080
# PEQ editor logs in as admin with PEQ_EDITOR_PASSWORD (required if enabled)
PEQ_EDITOR_PORT=8081
PEQ_EDITOR_PASSWORD=
